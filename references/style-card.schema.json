{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Reusable Image Style Card",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "instruction_version", "name", "summary", "source", "retain", "observed_content", "observed_composition", "observed_typography", "traits", "style_prompt", "uncertainties"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "instruction_version": {"enum": ["1.0", "1.1", "1.2", "1.3", "1.4", "2.0"]},
    "name": {"type": "string", "minLength": 1},
    "summary": {"type": "string", "minLength": 1},
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["reference_description", "analysis_model"],
      "properties": {
        "reference_description": {"type": "string", "minLength": 1},
        "analysis_model": {"type": ["string", "null"]}
      }
    },
    "retain": {
      "type": "object", "additionalProperties": false,
      "required": ["medium_material", "form", "lighting", "palette", "spatial_rendering", "composition", "typography"],
      "properties": {
        "medium_material": {"type": "boolean"},
        "form": {"type": "boolean"},
        "lighting": {"type": "boolean"},
        "palette": {"type": "boolean"},
        "spatial_rendering": {"type": "boolean"},
        "composition": {"type": "boolean"},
        "typography": {"type": "boolean"}
      }
    },
    "observed_content": {"$ref": "#/$defs/string_array"},
    "observed_composition": {"$ref": "#/$defs/string_array"},
    "observed_typography": {"$ref": "#/$defs/string_array"},
    "traits": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["category", "description", "evidence", "applies_to", "certainty"],
        "properties": {
          "category": {"enum": ["medium_material", "form", "lighting", "palette", "spatial_rendering"]},
          "description": {"type": "string", "minLength": 1},
          "evidence": {"type": "string", "minLength": 1},
          "applies_to": {"enum": ["all", "characters"]},
          "certainty": {"enum": ["high", "medium", "low"]}
        }
      }
    },
    "style_prompt": {
      "type": "object", "additionalProperties": false,
      "required": ["language", "text"],
      "properties": {
        "language": {"type": "string", "minLength": 2},
        "text": {"type": "string", "minLength": 1}
      }
    },
    "uncertainties": {"$ref": "#/$defs/string_array"}
  },
  "$defs": {"string_array": {"type": "array", "items": {"type": "string", "minLength": 1}}}
}
